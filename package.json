{
  "name": "digital-twin-workbench",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build:worker-sidecar": "node scripts/build-worker-sidecar.mjs",
    "generate:golden-fixtures": "node apps/worker/scripts/generate-golden-fixtures.mjs",
    "golden:qa": "pnpm --filter @digital-twin/worker exec tsx scripts/run-golden-project.ts",
    "smoke:packaged-worker": "node scripts/smoke-packaged-worker.mjs",
    "build:production-harness": "cargo build --release --manifest-path apps/desktop/src-tauri/Cargo.toml --features acceptance-harness --bin production-harness --bin process-rss-sampler",
    "harness:production": "node --import ./apps/worker/node_modules/tsx/dist/loader.mjs apps/desktop/scripts/run-packaged-production-harness.ts",
    "dev": "pnpm --filter @digital-twin/desktop tauri dev",
    "dev:web": "pnpm --parallel --filter @digital-twin/desktop --filter @digital-twin/worker dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm run test:core && pnpm run test:worker && pnpm run test:desktop && pnpm run test:rust",
    "test:core": "pnpm --filter @digital-twin/core test",
    "test:worker": "pnpm --filter @digital-twin/worker test",
    "test:desktop": "pnpm --filter @digital-twin/desktop test",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "esbuild": "0.28.2",
    "eslint": "^9.36.0",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
