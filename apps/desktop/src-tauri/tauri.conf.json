{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digital Twin Workbench",
  "version": "0.1.0",
  "identifier": "com.digitaltwin.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:tauri-assets",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Digital Twin Workbench", "width": 1440, "height": 960 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/digital-twin-worker"],
    "resources": {
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
